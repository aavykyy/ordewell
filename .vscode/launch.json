{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "Run Extension",
      "type": "extensionHost",
      "request": "launch",
      "args": [
        "--extensionDevelopmentPath=${workspaceFolder}/packages/vscode",
        "--user-data-dir=/tmp/vscode-ext-dev",
        "${workspaceFolder}"
      ],
      "outFiles": ["${workspaceFolder}/packages/vscode/dist/**/*.js"],
      "preLaunchTask": "npm: build"
    },
    {
      "name": "Run Extension (no debug)",
      "type": "extensionHost",
      "request": "launch",
      "noDebug": true,
      "args": [
        "--extensionDevelopmentPath=${workspaceFolder}/packages/vscode",
        "--user-data-dir=/tmp/vscode-ext-dev-nodebug",
        "${workspaceFolder}"
      ],
      "outFiles": ["${workspaceFolder}/packages/vscode/dist/**/*.js"],
      "preLaunchTask": "npm: build"
    },
    {
      "name": "Run Extension (no harness, no key)",
      "type": "extensionHost",
      "request": "launch",
      "args": [
        "--extensionDevelopmentPath=${workspaceFolder}/packages/vscode",
        "--user-data-dir=/tmp/ordewell-lab/vscode-dev",
        "--extensions-dir=/tmp/ordewell-lab/vscode-ext",
        "--disable-workspace-trust",
        "--skip-welcome",
        "--skip-release-notes",
        "/tmp/ordewell-lab/ws"
      ],
      "outFiles": ["${workspaceFolder}/packages/vscode/dist/**/*.js"],
      "env": {
        "HOME": "/tmp/ordewell-lab/home",
        "PATH": "/tmp/ordewell-lab/bin:/usr/bin:/bin",
        "SHELL": "/usr/bin/true",
        "LANG": "en_US.UTF-8",
        "VSCODE_CLI": "1",
        "OPENROUTER_API_KEY": "",
        "OPENAI_API_KEY": "",
        "ANTHROPIC_API_KEY": "",
        "GEMINI_API_KEY": "",
        "XAI_API_KEY": "",
        "DEEPSEEK_API_KEY": "",
        "GROQ_API_KEY": "",
        "MISTRAL_API_KEY": "",
        "TOGETHER_API_KEY": "",
        "FIREWORKS_API_KEY": "",
        "PERPLEXITY_API_KEY": "",
        "CEREBRAS_API_KEY": "",
        "DEEPINFRA_API_KEY": "",
        "COHERE_API_KEY": "",
        "NOVITA_API_KEY": "",
        "MOONSHOT_API_KEY": "",
        "ZHIPU_API_KEY": "",
        "DASHSCOPE_API_KEY": "",
        "ARK_API_KEY": "",
        "HUNYUAN_API_KEY": "",
        "BAICHUAN_API_KEY": "",
        "MINIMAX_API_KEY": "",
        "YI_API_KEY": "",
        "STEPFUN_API_KEY": "",
        "SILICONFLOW_API_KEY": "",
        "OPENAI_COMPATIBLE_BASE_URL": "",
        "OPENROUTER_BASE_URL": "",
        "GEMINI_BASE_URL": ""
      },
      "preLaunchTask": "npm: build"
    }
  ]
}
